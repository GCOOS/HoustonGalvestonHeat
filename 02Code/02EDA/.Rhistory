#create storage matrix
colNms <- c("Hour", "landuse", "MeanRH16", "MeanRH17", "MeanRH17s",
"MeanTemp16", "MeanTemp17", "MeanTemp17s", "MeanWSp16",
"MeanWSp17", "MeanWSp17s", "MeanSLP16", "MeanSLP17", "MeanSLP17s",
"MeanSLP16Diff", "MeanSLP17Diff", "MeanSLP17sDiff")
uLU <- unique(LU_dict$New_Name)
uLUnm <- unique(LU_dict$New_Num)
HourlyMean_byLU <- as.data.frame(matrix(0, ncol=length(colNms), nrow=length(uLU)*24))
names(HourlyMean_byLU) <- colNms
#set up your index for the storage matrix
smat_ind <- 1
for (h in 0:23){
#get hourly data
hr16 <- LandCells16[LandCells16$hour == h, ]
hr17 <- LandCells17[LandCells17$hour == h, ]
hr17s <- LandCells17s[LandCells17s$hour == h, ]
for (l in 1:length(uLUnm)){
HourlyMean_byLU$Hour[smat_ind] <- h
HourlyMean_byLU$landuse[smat_ind] <- uLU[l]
HourlyMean_byLU$MeanRH16[smat_ind] <- mean(hr16$rh2[hr16$landuse == uLU[l]])
HourlyMean_byLU$MeanRH17[smat_ind] <- mean(hr17$rh2[hr17$landuse == uLU[l]])
HourlyMean_byLU$MeanRH17s[smat_ind] <- mean(hr17s$rh2[hr17s$landuse == uLU[l]])
HourlyMean_byLU$MeanTemp16[smat_ind] <- mean(hr16$T2[hr16$landuse == uLU[l]])
HourlyMean_byLU$MeanTemp17[smat_ind] <- mean(hr17$T2[hr17$landuse == uLU[l]])
HourlyMean_byLU$MeanTemp17s[smat_ind] <- mean(hr17s$T2[hr17s$landuse == uLU[l]])
HourlyMean_byLU$MeanWSp16[smat_ind] <- mean(hr16$wspd[hr16$landuse == uLU[l]])
HourlyMean_byLU$MeanWSp17[smat_ind] <- mean(hr17$wspd[hr17$landuse == uLU[l]])
HourlyMean_byLU$MeanWSp17s[smat_ind] <- mean(hr17s$wspd[hr17s$landuse == uLU[l]])
HourlyMean_byLU$MeanSLP16[smat_ind] <- mean(hr16$slp[hr16$landuse == uLU[l]])
HourlyMean_byLU$MeanSLP17[smat_ind] <- mean(hr17$slp[hr17$landuse == uLU[l]])
HourlyMean_byLU$MeanSLP17s[smat_ind] <- mean(hr17s$slp[hr17s$landuse == uLU[l]])
HourlyMean_byLU$MeanSLP16Diff[smat_ind] <- mean(hr16$slpDiff[hr16$landuse == uLU[l]])
HourlyMean_byLU$MeanSLP17Diff[smat_ind] <- mean(hr17$slpDiff[hr17$landuse == uLU[l]])
HourlyMean_byLU$MeanSLP17sDiff[smat_ind] <- mean(hr17s$slpDiff[hr17s$landuse == uLU[l]])
#increase the iteration
smat_ind <- smat_ind + 1
}
}
#get rid of LU with no data
HourlyMean_byLU <- HourlyMean_byLU[!is.na(HourlyMean_byLU$MeanTemp16),]
#calculate your differences
HourlyMean_byLU$DiffRH17m16 <- HourlyMean_byLU$MeanRH17 - HourlyMean_byLU$MeanRH16
HourlyMean_byLU$DiffRH17m17s <- HourlyMean_byLU$MeanRH17 - HourlyMean_byLU$MeanRH17s
HourlyMean_byLU$DiffTemp17m16 <- HourlyMean_byLU$MeanTemp17 - HourlyMean_byLU$MeanTemp16
HourlyMean_byLU$DiffTemp17m17s <- HourlyMean_byLU$MeanTemp17 - HourlyMean_byLU$MeanTemp17s
HourlyMean_byLU$DiffWS17m16 <- HourlyMean_byLU$MeanWSp17 - HourlyMean_byLU$MeanWSp16
HourlyMean_byLU$DiffWS17m17s <- HourlyMean_byLU$MeanWSp17 - HourlyMean_byLU$MeanWSp17s
HourlyMean_byLU$DiffSLP17m16 <- HourlyMean_byLU$MeanSLP17 - HourlyMean_byLU$MeanSLP16
HourlyMean_byLU$DiffSLP17m17s <- HourlyMean_byLU$MeanSLP17 - HourlyMean_byLU$MeanSLP17s
HourlyMean_byLU$DiffSLP17m16Diff <- HourlyMean_byLU$MeanSLP17Diff - HourlyMean_byLU$MeanSLP16Diff
HourlyMean_byLU$DiffSLP17m17sDiff <- HourlyMean_byLU$MeanSLP17Diff - HourlyMean_byLU$MeanSLP17sDiff
head(HourlyMean_byLU)
#difference plots
ggplot(HourlyMean_byLU, aes(x=as.factor(Hour), y=(DiffSLP17m16), group=landuse)) +
geom_line(aes(color=landuse), linewidth=1) + ggtitle("2017 Minus 2016 Sea Level Pressure by Land Use") +
xlab("Hour") + ylab("Sea Level Pressure Difference")  + geom_hline(yintercept=0, linetype="dashed") +
coord_cartesian(ylim = c(-2.75, 0.25))+ theme_minimal()
ggplot(HourlyMean_byLU, aes(x=as.factor(Hour), y=(DiffSLP17m17s), group=landuse)) +
geom_line(aes(color=landuse), linewidth=1) + ggtitle("2017 Minus Simulated 2017 Sea Level Pressure by Land Use") +
xlab("Hour") + ylab("Sea Level Pressure Difference") + geom_hline(yintercept=0, linetype="dashed") +
coord_cartesian(ylim = c(-2.75, 0.25))+ theme_minimal()
