coord_cartesian(ylim = c(0, 0.35))
ggplot(LandCells17[c(LandCells17$hour %in% focalHRS),], aes(x=as.factor(hour), y=(llc))) +
geom_boxplot() + ggtitle("2017 Low Level Clouds") +
xlab("Hour") + ylab("Low Level Clouds")  +
coord_cartesian(ylim = c(0, 0.35))
ggplot(LandCells17s[c(LandCells17s$hour %in% focalHRS),], aes(x=as.factor(hour), y=(llc))) +
geom_boxplot() + ggtitle("Simulated 2017 Low Level Clouds") +
xlab("Hour") + ylab("Low Level Clouds") +
coord_cartesian(ylim = c(0, 0.35))
