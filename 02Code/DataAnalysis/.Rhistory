#aftHours2 <- c(17,18,19,20,21) #as the land starts to cool down
###TEMPERATURE
ggplot(HourlyMean_byLU, aes(x=as.factor(hour), y=(DiffTemp17m16), fill=LandUse)) +
geom_boxplot() + ggtitle("2017 Minus 2016 Early Afternoon Temperatures by Land Use") +
xlab("Hour") + ylab("Temperature Difference (C)")
###TEMPERATURE
