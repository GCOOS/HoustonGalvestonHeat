ReOrg_Temp16[,5] <- HourlyMeans16$X2mTemp[HourlyMeans16$hour == 16]
ReOrg_Temp16[,6] <- HourlyMeans16$X2mTemp[HourlyMeans16$hour == 17]
ReOrg_Temp16[,7] <- HourlyMeans16$X2mTemp[HourlyMeans16$hour == 18]
