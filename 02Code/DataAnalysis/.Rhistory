head(HourlyMeans16_modLU)
pts_16 <- HourlyMeans16_modLU[HourlyMeans16_modLU$hour == 18, c("GridCell", "lat", "long", "LandUse")]
pts_17 <- HourlyMeans17_modLU[HourlyMeans17_modLU$hour == 18, c("GridCell", "lat", "long", "LandUse")]
pts_17s <- HourlyMeans17_msst_modLU[HourlyMeans17_msst_modLU$hour == 18, c("GridCell", "lat", "long", "LandUse")]
#########################create the boxes
# Box 1 - bottom left
b1 <- matrix(c(
-96.2, 28.9, #bottom left
-96.2, 29.2, #top left
-95.8, 29.2, #top right
-95.8, 28.9, #bottom right
-96.2, 28.9 #bottom left
), ncol=2, byrow=TRUE)
b1_poly <- st_polygon(list(b1)) |> st_sfc(crs = 4326)
# Box 2 - top left
b2 <- matrix(c(
-96.4, 30.2, #bottom left
-96.4, 30.5, #top left
-96, 30.5, #top right
-96, 30.2, #bottom right
-96.4, 30.2 #bottom left
), ncol=2, byrow=TRUE)
b2_poly <- st_polygon(list(b2)) |> st_sfc(crs = 4326)
# Box 3 - top right
b3 <- matrix(c(
-94.8, 30, #bottom left
-94.8, 30.3, #top left
-94.4, 30.3, #top right
-94.4, 30, #bottom right
-94.8, 30 #bottom left
), ncol=2, byrow=TRUE)
b3_poly <- st_polygon(list(b3)) |> st_sfc(crs = 4326)
####################create the points
#get the relevant info
pts_16 <- HourlyMeans16_modLU[HourlyMeans16_modLU$hour == 18, c("GridCell", "lat", "long", "LandUse")]
pts_17 <- HourlyMeans17_modLU[HourlyMeans17_modLU$hour == 18, c("GridCell", "lat", "long", "LandUse")]
pts_17s <- HourlyMeans17_msst_modLU[HourlyMeans17_msst_modLU$hour == 18, c("GridCell", "lat", "long", "LandUse")]
#turn them into sf objects
pts_16_sf <- st_as_sf(pts_16, coords = c("long", "lat"), crs = 4326)
pts_17_sf <- st_as_sf(pts_17, coords = c("long", "lat"), crs = 4326)
pts_17s_sf <- st_as_sf(pts_17s, coords = c("long", "lat"), crs = 4326)
#######################look at intersection
#check which are inside - box 1
inside_logical_16b1 <- st_within(pts_16_sf, b1_poly, sparse = FALSE)[, 1]
inside_logical_17b1 <- st_within(pts_17_sf, b1_poly, sparse = FALSE)[, 1]
inside_logical_17sb1 <- st_within(pts_17s_sf, b1_poly, sparse = FALSE)[, 1]
pts_16_inside_b1 <- pts_16_sf[inside_logical_16b1, ]
pts_17_inside_b1 <- pts_17_sf[inside_logical_17b1, ]
pts_17s_inside_b1 <- pts_17s_sf[inside_logical_17sb1, ]
#check which are inside - box 2
inside_logical_16b2 <- st_within(pts_16_sf, b2_poly, sparse = FALSE)[, 1]
inside_logical_17b2 <- st_within(pts_17_sf, b2_poly, sparse = FALSE)[, 1]
inside_logical_17sb2 <- st_within(pts_17s_sf, b2_poly, sparse = FALSE)[, 1]
pts_16_inside_b2 <- pts_16_sf[inside_logical_16b2, ]
pts_17_inside_b2 <- pts_17_sf[inside_logical_17b2, ]
pts_17s_inside_b2 <- pts_17s_sf[inside_logical_17sb2, ]
#check which are inside - box 3
inside_logical_16b3 <- st_within(pts_16_sf, b3_poly, sparse = FALSE)[, 1]
inside_logical_17b3 <- st_within(pts_17_sf, b3_poly, sparse = FALSE)[, 1]
inside_logical_17sb3 <- st_within(pts_17s_sf, b3_poly, sparse = FALSE)[, 1]
pts_16_inside_b3 <- pts_16_sf[inside_logical_16b3, ]
pts_17_inside_b3 <- pts_17_sf[inside_logical_17b3, ]
pts_17s_inside_b3 <- pts_17s_sf[inside_logical_17sb3, ]
head(pts_16_inside_b3)
unique(pts_16_inside_b3$LandUse)
#####################2016
HourlyMeans16_wBoxes <- HourlyMeans16_modLU[HourlyMeans16_modLU$LandUse == "Crop",]
HourlyMeans16_wBoxes$Box <- NA
HourlyMeans16_wBoxes$Box[HourlyMeans16_wBoxes$GridCell %in% pts_16_inside_b1$GridCell] <- 1
HourlyMeans16_wBoxes$Box[HourlyMeans16_wBoxes$GridCell %in% pts_16_inside_b2$GridCell] <- 2
HourlyMeans16_wBoxes$Box[HourlyMeans16_wBoxes$GridCell %in% pts_16_inside_b3$GridCell] <- 3
HourlyMeans16_wBoxes <- HourlyMeans16_wBoxes[!is.na(HourlyMeans16_wBoxes$Box),]
length(HourlyMeans16_wBoxes)
length(HourlyMeans16_wBoxes$GridCell)
head(HourlyMeans16_wBoxes)
