ggplot(HourlyMean_byLU, aes(x=as.factor(Hour), y=(DiffSW17m16), group=LandUse)) +
geom_line(aes(color=LandUse), size=1) + ggtitle("2017 Minus 2016 Shortwave Radiation by Land Use") +
xlab("Hour") + ylab("Shortwave Radiation Flux Difference (W m-2)")  + geom_hline(yintercept=0, linetype="dashed") #+
#create storage matrix
colNms <- c("Hour", "LandUse", "MeanRH16", "MeanRH17", "MeanRH17s",
"MeanTemp16", "MeanTemp17", "MeanTemp17s", "MeanWSp16",
"MeanWSp17", "MeanWSp17s", "MeanSW16", "MeanSW17", "MeanSW17s")
uLU <- unique(LU_dict$New_Name)
uLUnm <- unique(LU_dict$New_Num)
HourlyMean_byLU <- as.data.frame(matrix(0, ncol=length(colNms), nrow=length(uLU)*24))
names(HourlyMean_byLU) <- colNms
#set up your index for the storage matrix
smat_ind <- 1
for (h in 0:23){
#get hourly data
hr16 <- HourlyMeans16_modLU[HourlyMeans16_modLU$hour == h, ]
hr17 <- HourlyMeans17_modLU[HourlyMeans17_modLU$hour == h, ]
hr17s <- HourlyMeans17_msst_modLU[HourlyMeans17_msst_modLU$hour == h, ]
for (l in 1:length(uLUnm)){
HourlyMean_byLU$Hour[smat_ind] <- h
HourlyMean_byLU$LandUse[smat_ind] <- uLU[l]
HourlyMean_byLU$MeanRH16[smat_ind] <- mean(hr16$RelHumid[hr16$LandUse == uLU[l]])
HourlyMean_byLU$MeanRH17[smat_ind] <- mean(hr17$RelHumid[hr17$LandUse == uLU[l]])
HourlyMean_byLU$MeanRH17s[smat_ind] <- mean(hr17s$RelHumid[hr17s$LandUse == uLU[l]])
HourlyMean_byLU$MeanTemp16[smat_ind] <- mean(hr16$X2mTemp[hr16$LandUse == uLU[l]])
HourlyMean_byLU$MeanTemp17[smat_ind] <- mean(hr17$X2mTemp[hr17$LandUse == uLU[l]])
HourlyMean_byLU$MeanTemp17s[smat_ind] <- mean(hr17s$X2mTemp[hr17s$LandUse == uLU[l]])
HourlyMean_byLU$MeanWSp16[smat_ind] <- mean(hr16$WindSpeed[hr16$LandUse == uLU[l]])
HourlyMean_byLU$MeanWSp17[smat_ind] <- mean(hr17$WindSpeed[hr17$LandUse == uLU[l]])
HourlyMean_byLU$MeanWSp17s[smat_ind] <- mean(hr17s$WindSpeed[hr17s$LandUse == uLU[l]])
HourlyMean_byLU$MeanSW16[smat_ind] <- mean(hr16$SWDown[hr16$LandUse == uLU[l]])
HourlyMean_byLU$MeanSW17[smat_ind] <- mean(hr17$SWDown[hr17$LandUse == uLU[l]])
HourlyMean_byLU$MeanSW17s[smat_ind] <- mean(hr17s$SWDown[hr17s$LandUse == uLU[l]])
#increase the iteration
smat_ind <- smat_ind + 1
}
}
#get rid of LU with no data
HourlyMean_byLU <- HourlyMean_byLU[!is.na(HourlyMean_byLU$MeanTemp16),]
#calculate your differences
HourlyMean_byLU$DiffRH17m16 <- HourlyMean_byLU$MeanRH17 - HourlyMean_byLU$MeanRH16
HourlyMean_byLU$DiffRH17m17s <- HourlyMean_byLU$MeanRH17 - HourlyMean_byLU$MeanRH17s
HourlyMean_byLU$DiffTemp17m16 <- HourlyMean_byLU$MeanTemp17 - HourlyMean_byLU$MeanTemp16
HourlyMean_byLU$DiffTemp17m17s <- HourlyMean_byLU$MeanTemp17 - HourlyMean_byLU$MeanTemp17s
HourlyMean_byLU$DiffWS17m16 <- HourlyMean_byLU$MeanWSp17 - HourlyMean_byLU$MeanWSp16
HourlyMean_byLU$DiffWS17m17s <- HourlyMean_byLU$MeanWSp17 - HourlyMean_byLU$MeanWSp17s
HourlyMean_byLU$DiffSW17m16 <- HourlyMean_byLU$MeanSW17 - HourlyMean_byLU$MeanSW16
HourlyMean_byLU$DiffSW17m17s <- HourlyMean_byLU$MeanSW17 - HourlyMean_byLU$MeanSW17s
head(HourlyMean_byLU)
#calculate wind speed
HourlyMeans16_modLU$WindSpeed <- sqrt(HourlyMeans16_modLU$UWind^2 + HourlyMeans16_modLU$VWind^2)
HourlyMeans17_modLU$WindSpeed <- sqrt(HourlyMeans17_modLU$UWind^2 + HourlyMeans17_modLU$VWind^2)
HourlyMeans17_msst_modLU$WindSpeed <- sqrt(HourlyMeans17_msst_modLU$UWind^2 + HourlyMeans17_msst_modLU$VWind^2)
#create storage matrix
colNms <- c("Hour", "LandUse", "MeanRH16", "MeanRH17", "MeanRH17s",
"MeanTemp16", "MeanTemp17", "MeanTemp17s", "MeanWSp16",
"MeanWSp17", "MeanWSp17s", "MeanSW16", "MeanSW17", "MeanSW17s")
uLU <- unique(LU_dict$New_Name)
uLUnm <- unique(LU_dict$New_Num)
HourlyMean_byLU <- as.data.frame(matrix(0, ncol=length(colNms), nrow=length(uLU)*24))
names(HourlyMean_byLU) <- colNms
#set up your index for the storage matrix
smat_ind <- 1
for (h in 0:23){
#get hourly data
hr16 <- HourlyMeans16_modLU[HourlyMeans16_modLU$hour == h, ]
hr17 <- HourlyMeans17_modLU[HourlyMeans17_modLU$hour == h, ]
hr17s <- HourlyMeans17_msst_modLU[HourlyMeans17_msst_modLU$hour == h, ]
for (l in 1:length(uLUnm)){
HourlyMean_byLU$Hour[smat_ind] <- h
HourlyMean_byLU$LandUse[smat_ind] <- uLU[l]
HourlyMean_byLU$MeanRH16[smat_ind] <- mean(hr16$RelHumid[hr16$LandUse == uLU[l]])
HourlyMean_byLU$MeanRH17[smat_ind] <- mean(hr17$RelHumid[hr17$LandUse == uLU[l]])
HourlyMean_byLU$MeanRH17s[smat_ind] <- mean(hr17s$RelHumid[hr17s$LandUse == uLU[l]])
HourlyMean_byLU$MeanTemp16[smat_ind] <- mean(hr16$X2mTemp[hr16$LandUse == uLU[l]])
HourlyMean_byLU$MeanTemp17[smat_ind] <- mean(hr17$X2mTemp[hr17$LandUse == uLU[l]])
HourlyMean_byLU$MeanTemp17s[smat_ind] <- mean(hr17s$X2mTemp[hr17s$LandUse == uLU[l]])
HourlyMean_byLU$MeanWSp16[smat_ind] <- mean(hr16$WindSpeed[hr16$LandUse == uLU[l]])
HourlyMean_byLU$MeanWSp17[smat_ind] <- mean(hr17$WindSpeed[hr17$LandUse == uLU[l]])
HourlyMean_byLU$MeanWSp17s[smat_ind] <- mean(hr17s$WindSpeed[hr17s$LandUse == uLU[l]])
HourlyMean_byLU$MeanSW16[smat_ind] <- mean(hr16$SWDown[hr16$LandUse == uLU[l]])
HourlyMean_byLU$MeanSW17[smat_ind] <- mean(hr17$SWDown[hr17$LandUse == uLU[l]])
HourlyMean_byLU$MeanSW17s[smat_ind] <- mean(hr17s$SWDown[hr17s$LandUse == uLU[l]])
#increase the iteration
smat_ind <- smat_ind + 1
}
}
#get rid of LU with no data
HourlyMean_byLU <- HourlyMean_byLU[!is.na(HourlyMean_byLU$MeanTemp16),]
#calculate your differences
HourlyMean_byLU$DiffRH17m16 <- HourlyMean_byLU$MeanRH17 - HourlyMean_byLU$MeanRH16
HourlyMean_byLU$DiffRH17m17s <- HourlyMean_byLU$MeanRH17 - HourlyMean_byLU$MeanRH17s
HourlyMean_byLU$DiffTemp17m16 <- HourlyMean_byLU$MeanTemp17 - HourlyMean_byLU$MeanTemp16
