#Re-organize 2017 - Temperature
#columns are one for each hour, one for distance2ocean, and one for land use
ReOrg_Temp17_msst <- as.data.frame(matrix(0, ncol=(length(HoursOfInterest) + 2), nrow =n17c))
HourlyMeans17_msst <- HourlyMeans17_msst[order(HourlyMeans17_msst$GridCell),] #make sure the order is consistent so you know which points are which
#Get your hourly temps - response
ReOrg_Temp17_msst[,1] <- HourlyMeans17_msst$X2mTemp[HourlyMeans17_msst$hour == 12]
ReOrg_Temp17_msst[,2] <- HourlyMeans17_msst$X2mTemp[HourlyMeans17_msst$hour == 13]
ReOrg_Temp17_msst[,3] <- HourlyMeans17_msst$X2mTemp[HourlyMeans17_msst$hour == 14]
