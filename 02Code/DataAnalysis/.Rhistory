min_lon, max_lat, #top left
max_lon, max_lat, #top right
max_lon, min_lat, #bottom right
min_lon, min_lat #bottom left
)
main_box <- create_box(main_coords, "Main Box")
# Southwest box
sw_coords <- c(
-96.2, 28.9, #bottom left
-96.2, 29.2, #top left
-95.8, 29.2, #top right
-95.8, 28.9, #bottom right
-96.2, 28.9 #bottom left
)
sw_box <- create_box(sw_coords, "SW Box")
# Northeast box
ne_coords <- c(
-94.8, 30, #bottom left
-94.8, 30.3, #top left
-94.4, 30.3, #top right
-94.4, 30, #bottom right
-94.8, 30 #bottom left
)
ne_box <- create_box(ne_coords, "NE Box")
# Top-left box
tl_coords <- c(
-96.4, 30.2, #bottom left
-96.4, 30.5, #top left
-96, 30.5, #top right
-96, 30.2, #bottom right
-96.4, 30.2 #bottom left
)
tl_box <- create_box(tl_coords, "Top-Left Box")
